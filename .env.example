# ===== DeepSeek LLM =====
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
LLM_JUDGE_MODEL_NAME=deepseek-chat
LLM_LITE_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ===== Embedding (硅基流动) =====
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ===== RAG =====
RAG_TOP_K=5
RAG_MAX_ITERATIONS=3
RAG_JUDGE_THRESHOLD=0.7
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
USE_HYBRID_SEARCH=true
USE_RERANKER=true

# Optional per-role models; blank values reuse LLM_MODEL_NAME.
LLM_ROUTER_MODEL_NAME=
LLM_REASONER_MODEL_NAME=

# On Windows, use an ASCII path for Chroma/HNSW persistence if the project path is Chinese.
# CHROMA_DIR=C:/aeroregqa_chroma_db

# ===== API / 上传安全 =====
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
MAX_UPLOAD_SIZE_MB=50
SUPPORTED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md,.csv
